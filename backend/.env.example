# ==========================================================
# Backend Environment Configuration Example
# Copy to .env for local development or enter into Vercel
# ==========================================================

# Database Connection (Neon PostgreSQL URL)
# Example: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST.neon.tech/neondb?sslmode=require

# JWT Secret Key for Session Authentication (Generate a long random string)
# e.g., run in terminal: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Origin for CORS (Your Vercel Domain URL if accessed externally)
# Keep comma-separated if supporting multiple origins
FRONTEND_URL=https://your-attendly-app.vercel.app

# Admin MPIN (Numeric 4 or 6 digits) used to log in
ADMIN_MPIN=1234

# Optional: Environment flag
ENVIRONMENT=production
