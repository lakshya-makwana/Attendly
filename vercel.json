{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/attendance",
      "destination": "/index.html"
    },
    {
      "source": "/workers/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/workers",
      "destination": "/index.html"
    },
    {
      "source": "/sites",
      "destination": "/index.html"
    },
    {
      "source": "/advances",
      "destination": "/index.html"
    },
    {
      "source": "/payroll",
      "destination": "/index.html"
    },
    {
      "source": "/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
