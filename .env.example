# ==========================================================
# Attendly - Full Stack Environment Variables Example
# ==========================================================

# -----------------
# Backend (FastAPI / Vercel Environment Variables)
# -----------------
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST.neon.tech/neondb?sslmode=require
JWT_SECRET=your_long_random_secret_token_key_here
ADMIN_MPIN=1234
FRONTEND_URL=https://your-attendly-app.vercel.app

# -----------------
# Frontend (React + Vite / Vercel Environment Variables)
# Optional: In Vercel production, /api is handled via vercel.json rewrites
# -----------------
VITE_API_URL=https://your-attendly-app.vercel.app
