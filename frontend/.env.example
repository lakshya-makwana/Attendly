# ==========================================================
# Frontend Environment Configuration Example
# Copy to .env for local development
# Note: In production on Vercel, this is optional since /api is rewritten directly
# ==========================================================

# Backend API URL (Optional in production; defaults to /api)
# Example: https://your-attendly-app.vercel.app
VITE_API_URL=https://your-attendly-app.vercel.app
